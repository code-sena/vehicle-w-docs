# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Variables de ambiente de LavaRápido (referencia)
#
# El archivo que usan los servicios es lavarapido-infra/.env (plantilla: lavarapido-infra/.env.example).
# Este archivo es una copia de referencia para la documentación: si cambia allá, actualizar aquí.
#
# NUNCA: commitear un .env con valores reales. Aquí solo van nombres y valores de ejemplo.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Base de datos (SQL Server, una base compartida, un esquema por servicio) ──
DB_PASSWORD=ChangeMe_2026!
DB_NAME=LavaRapido
DB_USERNAME=sa
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=LavaRapido;encrypt=true;trustServerCertificate=true
# payment-service (.NET) arma su cadena de conexión con estas (no usa DB_URL)
# DB_HOST=localhost
# DB_PORT=1433

# ─── JWT HS256 (ADR-006): el mismo secreto en todos los servicios. Mínimo 32 bytes ──
# Se genera con:  openssl rand -base64 48
JWT_SECRET=
# JWT_ISSUER=lavarapido-security-service
# JWT_AUDIENCE=lavarapido-api

CORS_ALLOWED_ORIGINS=http://localhost:4200

# ─── Puertos (todos tienen default; solo cambiar si hay choque) ────────────────
# GATEWAY_PORT=8080          # api-gateway
# PORT=3001                  # security-service  (cada servicio Java lee PORT con su propio default)
# PORT=3002                  # customer-service
# PORT=3003                  # booking-service
# OPERATIONS_PORT=3004       # operations-service (ojo: no usa PORT)
# PAYMENT_PORT=3005          # payment-service, .NET (ojo: no usa PORT)
# PORT=3006                  # notification-service

# ─── URLs entre servicios (REST, ADR-004) ─────────────────────────────────────
# SECURITY_SERVICE_URL=http://localhost:3001/api/v1     # customer, operations (notification usa http://localhost:3001)
# CUSTOMER_SERVICE_URL=http://localhost:3002/api/v1     # booking
# BOOKING_SERVICE_URL=http://localhost:3003/api/v1      # operations, payment
# SECURITY_SERVICE_TIMEOUT=3s
# CUSTOMER_SERVICE_TIMEOUT=3s
# BOOKING_SERVICE_TIMEOUT=3s

# ─── Rutas del API Gateway ────────────────────────────────────────────────────
# ROUTE_SECURITY_URL=http://localhost:3001
# ROUTE_CUSTOMER_URL=http://localhost:3002
# ROUTE_BOOKING_URL=http://localhost:3003
# ROUTE_OPERATIONS_URL=http://localhost:3004
# ROUTE_PAYMENT_URL=http://localhost:3005
# ROUTE_NOTIFICATION_URL=http://localhost:3006

# ─── Reservas ──────────────────────────────────────────────────────────────────
# BOOKING_ZONE=America/Bogota            # booking y operations
# BOOKING_SLOT_MINUTES=30
# BOOKING_MAX_DAYS_AHEAD=60

# ─── Correo (security: código de recuperación; notification: avisos) ──────────
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=dev
MAIL_PASSWORD=dev
MAIL_FROM=LavaRápido <no-reply@lavarapido.local>
# MAIL_DOCKER_HOST=mailpit   # host del correo visto desde Docker (--profile app)

# ─── RabbitMQ (eventos, ADR-004) ───────────────────────────────────────────────
MESSAGING_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ─── Notificaciones push (notification-service, ADR-011) ──────────────────────
PUSH_ENABLED=false
# EXPO_ACCESS_TOKEN=

# ─── Llave entre servicios (/internal/**, ADR-011 sección 8) ─────────────────
INTERNAL_API_KEY=
# REMINDER_LEADS=24h,1h
# REMINDER_CHECK_INTERVAL=5m
